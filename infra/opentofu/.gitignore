# Terraform/OpenTofu state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform/OpenTofu directories
.terraform/
.tofu/
.terraform.lock.hcl

# Variable files with secrets
*.tfvars
!terraform.tfvars.example

