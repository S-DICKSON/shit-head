# Example Terraform variables file
# Copy this file to terraform.tfvars and fill in your values
# terraform.tfvars is gitignored to protect secrets

# Get your Render API key from: https://dashboard.render.com/account/settings
render_api_key = "your-render-api-key-here"

# Project name prefix for Render services
project_name = "shithead-online"

# Your GitHub repository URL
repo_url = "https://github.com/YOUR_USERNAME/shit-head"

# Render region (oregon, frankfurt, singapore, ohio)
region = "oregon"
