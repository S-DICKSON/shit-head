# Hetzner Cloud credentials
# These are injected via Infisical: infisical run -- tofu apply
# Only needed if running tofu apply manually without Infisical
hcloud_token   = "your-hetzner-api-token"

# SSH public key for VPS access
ssh_public_key = "ssh-ed25519 AAAA... your-email@example.com"

# Domain for Caddy HTTPS (default: splatmonkey.com)
# domain = "splatmonkey.com"
